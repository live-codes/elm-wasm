# Pinned versions for the compiler build.
# Sourced as shell by compiler/*.sh, and by the GitHub workflow.
# Update with:  node scripts/update-compiler-pins.mjs --write

# --- Upstream source ---------------------------------------------------------
# WASM port of the Elm compiler. A fork of elm/compiler (BSD-3-Clause).
# https://github.com/marc136/elm-compiler-wasm  — the wasm build is on `main-wasm`.
ELM_WASM_REPO=https://github.com/marc136/elm-compiler-wasm.git
ELM_WASM_REF=main-wasm
ELM_WASM_COMMIT=038eb194555ece5a043575a22533b2536cc9de61

# The Elm compiler itself, vendored as a git submodule of the repo above
# (its .gitmodules points at the same repo, branch `elm-0.19.1-wasm`).
ELM_SRC_COMMIT=cb8225e5391b91efc9eec23c42eec6a09586e310

# --- Toolchain ---------------------------------------------------------------
# ghc-wasm-meta provides wasm32-wasi-ghc, wasm32-wasi-cabal, wasi-sdk, node and
# binaryen (wasm-opt). Pin it by commit for reproducibility; `master` tracks the
# latest and is what the upstream project uses.
GHC_WASM_META_REF=master

# GHC release branch to install. The fork was originally built against a GHC
# 9.11 nightly; 9.12 is the closest released toolchain providing GHC.Wasm.Prim
# (via the `ghc-experimental` boot library). Bump this if the build breaks.
GHC_WASM_FLAVOUR=9.12

# --- Build options -----------------------------------------------------------
# Run `wasm-opt -Oz` on the output. Off by default: it is a separate, manual
# step upstream and we cannot verify it here, so we ship the plain link output.
OPTIMIZE=0
# Which executables to build: `ulm` is the module/compile entry point used by
# this PoC; `repl` is elm.run's REPL build.
ELM_WASM_EXES=ulm
