{
  "name": "elm-in-browser-poc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Proof of concept: compiling Elm to JavaScript entirely in the browser (for a future LiveCodes integration).",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "build:index": "node scripts/build-module-index.mjs",
    "build:compiler": "bash compiler/build.sh",
    "install:toolchain": "bash compiler/install-toolchain.sh",
    "check:pins": "node scripts/update-compiler-pins.mjs --check",
    "update:pins": "node scripts/update-compiler-pins.mjs --write",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node scripts/test-compile.mjs",
    "test:packages": "node scripts/test-packages.mjs",
    "test:imports": "node scripts/test-imports.mjs",
    "test:sources": "node scripts/test-sources.mjs",
    "test:importmap": "node scripts/test-importmap.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "nanotar": "^0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
