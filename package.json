{
  "name": "elm-in-browser-poc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Proof of concept: compiling Elm to JavaScript entirely in the browser (for a future LiveCodes integration).",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node scripts/test-compile.mjs",
    "test:packages": "node scripts/test-packages.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "nanotar": "^0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
