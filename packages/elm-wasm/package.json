{
  "name": "@live-codes/elm-wasm",
  "version": "0.2.1",
  "description": "The Elm compiler compiled to WebAssembly — compile Elm to JavaScript in the browser, a web worker, or Node.",
  "keywords": [
    "elm",
    "compiler",
    "wasm",
    "webassembly",
    "livecodes"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "esbuild": "^0.25.0",
    "nanotar": "^0.2.0"
  }
}
